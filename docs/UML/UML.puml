@startuml Buckshot Roulette
title Buckshot Roulette (MVC, passive view, pull + push compatible)
skinparam {
    ClassBackgroundColor White
    ClassBorderColor Black
    FontSize 12
    TitleFontSize 14
    TitleFontStyle bold
}

hide empty members

package "Model Layer" {

    interface Model {
        + shoot(toDealer : boolean) : int
        + gameIsOver() : boolean
        + useObject(SpecialObject) : boolean
        + isPlayerTurn() : boolean
        + getGameData() : GameState
    }

    class ModelImpl {
        - dealer : Participant
        - player : Participant
        - strategy : AIStrategy
        - shotgun : Shotgun
        - turnManager : TurnManager
        + distributeObjects() : Pair<List<SpecialObject>, List<SpecialObject>>
    }
    ModelImpl ..|> Model : implements

    interface Participant {
        + addObjects(List<SpecialObject>) : void
        + useObject(SpecialObject, opponent : Participant, Shotgun) : boolean
        + shoot(Shotgun, target : Participant) : int
        + isDead() : boolean
    }

    abstract class AbstractParticipant {
        - objects : List<SpecialObject>
        - lives : LivesManager
    }

    class TurnManager {
        + endTurn(blank : boolean, selfShot : boolean) : void
        + isPlayerTurn() : boolean
    }

    class Dealer {
    }

    class Player {
    }

    AbstractParticipant <|-- Dealer : extends
    AbstractParticipant <|-- Player : extends
    Participant <|.. AbstractParticipant

    interface SpecialObject {
        + use(user : Participant, opponent : Participant, Shotgun) : void
    }

    class LivesManager {
        - maxLives : int
        - initialLives : int
        + noLivesRemaining() : boolean
        + heal() : void
        + takeDamage(damage : int) : void
    }

    class Shotgun {
        - bullets : List<Boolean>
        + isEmpty() : boolean
        + recharge() : void
        + isBulletAlive() : boolean
        + shoot() : boolean
        + cut() : void
        + isSawed() : boolean
        + getDamage() : int
        + howManyRemaining() : int
        + skip() : void
    }

    interface AIStrategy {
        + getObjectsChosen() : List<SpecialObject>
        + shootToPlayer() : boolean
    }

    class BasicStrategy {
    }

    class GameState {
        - shotgun : ShotgunState
        - dealer : ParticipantState
        - player : ParticipantState
        - objects : List<SpecialObject>
    }

    class Beer {
    }

    class Cigarette {
    }

    class Saw {
    }

    class Handcuffs {
    }

    class MagnifyingGlass {
    }
}

package "Controller" {

    interface InputHandler {
        + onActionChosen(Action) : void
    }

    class Action {
        + type : ActionType
        + object : SpecialObject
    }

    enum ActionType {
        SHOOT_SELF
        SHOOT_OPPONENT
        USE_OBJECT
    }

    class Controller {
        - view : View
        - model : Model
        + start() : void
        + onActionChosen(Action) : void
    }
    Controller ..|> InputHandler : implements
    Action *-- ActionType
}

package "View" {

    interface View {
        + display(GameState) : void
        + showGameOver(winner : String) : void
        + showError(message : String) : void
    }

    class ConsoleView {
        - inputHandler : InputHandler
        - scanner : Scanner
        + run() : void
    }

    class SwingView {
        - inputHandler : InputHandler
        + initComponents() : void
    }

    ConsoleView ..|> View : implements
    SwingView ..|> View : implements
    ConsoleView --> InputHandler : uses
    SwingView --> InputHandler : uses
}

ModelImpl *-- Participant : contains 2
SpecialObject *-- AbstractParticipant : owns multiple
LivesManager *-- AbstractParticipant
Controller --> Model : controls
Controller --> View : updates
Shotgun *-down- ModelImpl : contains
AIStrategy *-- ModelImpl : contains
TurnManager *-- ModelImpl : contains
Beer ..|> SpecialObject
Handcuffs ..|> SpecialObject
Cigarette ..|> SpecialObject
MagnifyingGlass ..|> SpecialObject
Saw ..|> SpecialObject
BasicStrategy ..|> AIStrategy

@enduml
