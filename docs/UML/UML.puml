@startuml Buckshot Roulette
title Buckshot Roulette (MVC, passive view, snapshot)
skinparam {
    ClassBackgroundColor White
    ClassBorderColor Black
    FontSize 12
    TitleFontSize 14
    TitleFontStyle bold
}

hide empty members

package "Model Layer" {

    interface Model {
        + shoot(target : Target) : ShotOutcome
        + gameIsOver() : boolean
        + utilizeObject(ItemType) : ItemResult
        + isPlayerTurn() : boolean
        + getGameData() : GameState
        + playDealerTurn() : ShotOutcome
    }

    class ModelImpl {
        - dealer : Participant
        - player : Participant
        - strategy : AIStrategy
        - shotgun : Shotgun
        - turnManager : TurnManager
        + playDealerTurn() : ShotOutcome
    }
    ModelImpl ..|> Model : implements

    interface Participant {
        + addObjects(List<SpecialItem>) : void
        + useObject(ItemType, opponent : Participant, Shotgun) : ItemResult
        + shoot(Shotgun, target : Participant) : ShotResult
        + heal() : void
        + takeDamage(damage : int) : void
        + restrain() : void
        + consumeRestraint() : boolean
        + isRestrained() : boolean
        + isDead() : boolean
        + getState() : CharacterState
    }

    class ParticipantImpl {
        - items : List<SpecialItem>
        - lives : LivesManager
        - restrained : boolean
    }

    class TurnManager {
        + endTurn(blank : boolean, selfShot : boolean, opponentRestrained : boolean) : void
        + isPlayerTurn() : boolean
    }

    ParticipantImpl ..|> Participant : implements

    interface SpecialItem {
        + getType() : ItemType
        + use(user : Participant, opponent : Participant, Shotgun) : ItemResult
    }

    class LivesManager {
        - maxLives : int
        - currentLives : int
        + noLivesRemaining() : boolean
        + heal() : void
        + takeDamage(damage : int) : void
    }

    interface Shotgun {
        + isEmpty() : boolean
        + recharge() : void
        + peekNextShell() : Shell
        + shoot() : ShotResult
        + cut() : void
        + isSawed() : boolean
        + getDamage() : int
        + howManyRemaining() : int
        + eject() : Shell
        + getState() : ShotgunState
    }

    interface AIStrategy {
        + chooseTarget(GameState) : Target
    }

    class BasicStrategy {
    }

    class GameState {
        - shotgun : ShotgunState
        - dealer : CharacterState
        - player : CharacterState
        - playerTurn : boolean
        - winner : Winner
    }

    class Beer {
    }

    class Cigarette {
    }

    class Saw {
    }

    class Handcuffs {
    }

    class MagnifyingGlass {
    }
}

package "Controller" {

    interface InputHandler {
        + onActionChosen(Action) : void
    }

    class Action {
        + type : ActionType
        + item : ItemType
    }

    enum ActionType {
        SHOOT_SELF
        SHOOT_OPPONENT
        USE_OBJECT
    }

    class Controller {
        - view : View
        - model : Model
        + start() : void
        + stop() : void
        + onActionChosen(Action) : void
    }
    Controller ..|> InputHandler : implements
    Action --> ActionType
}

package "View" {

    interface View {
        + setInputHandler(InputHandler) : void
        + display(GameState) : void
        + showMessage(message : String) : void
        + showGameOver(winner : Winner) : void
        + showError(message : String) : void
        + scheduleDealerAction(Runnable) : void
        + cancelPendingActions() : void
    }

    class JavaFXView {
        - inputHandler : InputHandler
        + getRoot() : Parent
    }

    JavaFXView ..|> View : implements
    JavaFXView --> InputHandler : sends actions

}

ModelImpl *-- "2" Participant : contains
ParticipantImpl *-- "0..8" SpecialItem : inventory
ParticipantImpl *-- LivesManager
Controller --> Model : controls
Controller --> View : updates
ModelImpl *-- Shotgun : contains
ModelImpl *-- AIStrategy : contains
ModelImpl *-- TurnManager : contains
Beer ..|> SpecialItem
Handcuffs ..|> SpecialItem
Cigarette ..|> SpecialItem
MagnifyingGlass ..|> SpecialItem
Saw ..|> SpecialItem
BasicStrategy ..|> AIStrategy

class ShotgunImpl
ShotgunImpl ..|> Shotgun
class ShotResult {
    + shell : Shell
    + damage : int
}
class ShotOutcome {
    + target : Target
    + shot : ShotResult
    + reloaded : boolean
}
ShotOutcome *-- ShotResult
ShotOutcome --> Target
Model ..> ShotOutcome
enum Shell {
    LIVE
    BLANK
}
interface ItemResult <<sealed>> {
    + isApplied() : boolean
    --
    + NotUsable()
    + Healed()
    + ShotgunSawed()
    + OpponentRestrained()
    + ShellInspected(shell : Shell)
    + ShellEjected(shell : Shell)
}
SpecialItem ..> ItemResult
Shotgun ..> Shell
ItemResult ..> Shell
class CharacterState {
    + lives : int
    + maxLives : int
    + items : List<ItemType>
    + restrained : boolean
}
class ShotgunState {
    + liveShells : int
    + blankShells : int
    + sawed : boolean
}
enum Target {
    SELF
    OPPONENT
}
enum Winner {
    NONE
    PLAYER
    DEALER
}
enum ItemType {
    BEER
    CIGARETTE
    SAW
    HANDCUFFS
    MAGNIFYING_GLASS
}
GameState *-- CharacterState
GameState *-- ShotgunState
@enduml
