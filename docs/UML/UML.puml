@startuml Buckshot Roulette
title Buckshot Roulette (MVC, passive view, snapshot)
skinparam {
    ClassBackgroundColor White
    ClassBorderColor Black
    FontSize 12
    TitleFontSize 14
    TitleFontStyle bold
}

hide empty members

package "Model Layer" {

    interface Model {
        + shoot(target : Target) : int
        + gameIsOver() : boolean
        + utilizeObject(ItemType) : boolean
        + isPlayerTurn() : boolean
        + getGameData() : GameState
        + distributeObjects() : void
        + inspectNextShell() : boolean
        + playDealerTurn() : int
    }

    class ModelImpl {
        - dealer : Character
        - player : Character
        - strategy : AIStrategy
        - shotgun : Shotgun
        - turnManager : TurnManager
        + distributeObjects() : void
        + playDealerTurn() : int
        + inspectNextShell() : boolean
    }
    ModelImpl ..|> Model : implements

    interface Character {
        + addObjects(List<SpecialItem>) : void
        + useObject(SpecialItem, opponent : Character, Shotgun) : boolean
        + shoot(Shotgun, target : Character) : ShotResult
        + heal() : void
        + takeDamage(damage : int) : void
        + restrain() : void
        + consumeRestraint() : boolean
        + getState() : CharacterState
        + isDead() : boolean
    }

    abstract class AbstractCharacter {
        - items : List<SpecialItem>
        - lives : LivesManager
    }

    class TurnManager {
        + endTurn(blank : boolean, selfShot : boolean, opponentRestrained : boolean) : void
        + isPlayerTurn() : boolean
    }

    class Participant {
    }

    AbstractCharacter <|-- Participant : extends
    Character <|.. AbstractCharacter

    interface SpecialItem {
        + getType() : ItemType
        + use(user : Character, opponent : Character, Shotgun) : boolean
    }

    class LivesManager {
        - maxLives : int
        - currentLives : int
        + noLivesRemaining() : boolean
        + heal() : void
        + takeDamage(damage : int) : void
    }

    interface Shotgun {
        + isEmpty() : boolean
        + recharge() : void
        + isBulletAlive() : boolean
        + shoot() : ShotResult
        + cut() : void
        + isSawed() : boolean
        + getDamage() : int
        + howManyRemaining() : int
        + skip() : void
        + getState() : ShotgunState
    }

    interface AIStrategy {
        + chooseTarget(GameState) : Target
    }

    class BasicStrategy {
    }

    class GameState {
        - shotgun : ShotgunState
        - dealer : CharacterState
        - player : CharacterState
        - playerTurn : boolean
        - winner : Winner
    }

    class Beer {
    }

    class Cigarette {
    }

    class Saw {
    }

    class Handcuffs {
    }

    class MagnifyingGlass {
    }
}

package "Controller" {

    interface InputHandler {
        + onActionChosen(Action) : void
    }

    class Action {
        + type : ActionType
        + item : ItemType
    }

    enum ActionType {
        SHOOT_SELF
        SHOOT_OPPONENT
        USE_OBJECT
    }

    class Controller {
        - view : View
        - model : Model
        + start() : void
        + onActionChosen(Action) : void
    }
    Controller ..|> InputHandler : implements
    Action --> ActionType
}

package "View" {

    interface View {
        + display(GameState) : void
        + showGameOver(winner : String) : void
        + showError(message : String) : void
    }

    class ConsoleView {
        - inputHandler : InputHandler
        - scanner : Scanner
        + run() : void
    }

    class SwingView {
        - inputHandler : InputHandler
        + initComponents() : void
    }

    ConsoleView ..|> View : implements
    SwingView ..|> View : implements
    ConsoleView --> InputHandler : uses
    SwingView --> InputHandler : uses
}

ModelImpl *-- "2" Character : contains
AbstractCharacter *-- "0..*" SpecialItem : inventory
AbstractCharacter *-- LivesManager
Controller --> Model : controls
Controller --> View : updates
ModelImpl *-- Shotgun : contains
ModelImpl *-- AIStrategy : contains
ModelImpl *-- TurnManager : contains
Beer ..|> SpecialItem
Handcuffs ..|> SpecialItem
Cigarette ..|> SpecialItem
MagnifyingGlass ..|> SpecialItem
Saw ..|> SpecialItem
BasicStrategy ..|> AIStrategy

class ShotgunImpl
ShotgunImpl ..|> Shotgun
class ShotResult {
    + live : boolean
    + damage : int
}
class CharacterState {
    + lives : int
    + maxLives : int
    + items : List<ItemType>
    + restrained : boolean
}
class ShotgunState {
    + liveShells : int
    + blankShells : int
    + sawed : boolean
}
enum Target {
    SELF
    OPPONENT
}
enum Winner {
    NONE
    PLAYER
    DEALER
}
enum ItemType {
    BEER
    CIGARETTE
    SAW
    HANDCUFFS
    MAGNIFYING_GLASS
}
GameState *-- CharacterState
GameState *-- ShotgunState
@enduml
